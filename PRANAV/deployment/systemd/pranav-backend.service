[Unit]
Description=PRANAV Node.js Core & Telegram Multi-Bot Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pranav
Group=pranav
WorkingDirectory=/opt/pranav/backend
EnvironmentFile=/opt/pranav/.env.production
ExecStart=/usr/bin/node /opt/pranav/backend/src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pranav
MemoryMax=768M

[Install]
WantedBy=multi-user.target
